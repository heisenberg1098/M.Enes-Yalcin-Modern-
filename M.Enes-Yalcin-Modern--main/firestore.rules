rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'admin';
    }

    function isPublicWebsite(data) {
      return ('isPublished' in data && data.isPublished == true)
        || ('status' in data && (data.status == 'active' || data.status == 'development'));
    }

    function isCounterIncrement(field) {
      return (field in resource.data
          && resource.data[field] is number
          && request.resource.data[field] is number
          && request.resource.data[field] == resource.data[field] + 1)
        || (!(field in resource.data)
          && request.resource.data[field] is number
          && request.resource.data[field] == 1);
    }

    match /admin_users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /websiteler/{websiteId} {
      allow get, list: if isAdmin() || isPublicWebsite(resource.data);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isPublicWebsite(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'tiklanmaSayisi', 'views'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['clicks', 'tiklanmaSayisi', 'views'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['clicks', 'tiklanmaSayisi'])
          || (isCounterIncrement('clicks') && isCounterIncrement('tiklanmaSayisi')))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['views'])
          || isCounterIncrement('views'))
      );
    }

    match /Bilgilendirme/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mesajlar/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['isim', 'email', 'konu', 'mesaj', 'tarih'])
        && request.resource.data.keys().hasOnly(['isim', 'email', 'konu', 'mesaj', 'tarih'])
        && request.resource.data.isim is string
        && request.resource.data.isim.size() > 0
        && request.resource.data.isim.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 320
        && request.resource.data.konu is string
        && request.resource.data.konu.size() > 0
        && request.resource.data.konu.size() <= 180
        && request.resource.data.mesaj is string
        && request.resource.data.mesaj.size() > 0
        && request.resource.data.mesaj.size() <= 5000
        && request.resource.data.tarih == request.time;
      allow get, list, update, delete: if isAdmin();
    }

    // The old plaintext password document is no longer used by the app.
    // Keep it inaccessible without deleting existing data.
    match /ayarlar/{settingId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
